# .gitignore

# 파이썬 컴파일 파일 무시
__pycache__/
*.py[cod]

# 빌드 관련 폴더 무시 (pip 업로드용 파일들)
dist/
build/
*.egg-info/

# 가상환경 무시
venv/
env/
.env

# PyPI 업로드 설정 파일 (내 비밀번호 들어있음!! 절대 금지)
.pypirc

.omx
.codex
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**
.github
AGENTS.md